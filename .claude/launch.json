{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "smriti-dev",
      "url": "http://localhost:3000"
    },
    {
      "name": "smriti-dev-start",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "smriti",
      "port": 3000
    },
    {
      "name": "smriti-secure-storage",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "cwd": ".claude/worktrees/secure-storage-impl/smriti",
      "port": 3100
    }
  ]
}